{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/resources/(.*)$",
      "target": "/resources/$1",
      "destination": "ui5",
      "csrfProtection": false
    },
    {
      "source": "^/test-resources/(.*)$",
      "target": "/test-resources/$1",
      "destination": "ui5",
      "csrfProtection": false
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "csrfProtection": true
    },
    {
      "source": "^/service/(.*)$",
      "target": "/service/$1",
      "destination": "srv-api",
      "csrfProtection": true
    },
    {
      "source": "^(/.*)$",
      "target": "$1",
      "destination": "html5-apps-repo-rt",
      "csrfProtection": false
    }
  ],
  "welcomeFile": "/loyaltydashboard/index.html"
}
