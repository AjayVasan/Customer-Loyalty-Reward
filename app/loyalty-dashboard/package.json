{
  "name": "loyalty-dashboard",
  "version": "1.0.0",
  "description": "Role-aware loyalty operations dashboard: record purchases, redeem points, manage reward policies",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "scripts": {
    "build": "npm run build:cf",
    "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo"
  },
  "devDependencies": {
    "@ui5/cli": "^3.0.0",
    "ui5-task-zipper": "^3"
  }
}
